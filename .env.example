# ─────────────────────────────────────────────────────────────
# HAVEN® environment
# Copy to .env.local. Never commit real secrets.
# ─────────────────────────────────────────────────────────────

# Storage driver: "sqlite" (default) or "supabase".
HAVEN_DB_DRIVER=sqlite

# Local persistence (default when Supabase is not configured).
# SQLite database + uploaded media live here. Must be a writable,
# persistent volume in production (e.g. a mounted disk).
HAVEN_DATA_DIR=.data

# Session signing secret. REQUIRED in production (>= 32 chars).
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Public site URL (used for metadata / absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (optional) ────────────────────────────────────────
# When BOTH url + service role key + anon key are present, the app
# uses Supabase Postgres + Storage + Auth instead of the local SQLite
# store. Run supabase/migrations/0001_init.sql and 0002_rls.sql first.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_MEDIA_BUCKET=haven-media

# Local demo administrator (only used by the local SQLite store,
# and only when the seed runs). Change before any real deployment.
HAVEN_SEED_ADMIN_EMAIL=admin@haven.pt
HAVEN_SEED_ADMIN_PASSWORD=Haven!2026
